# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for isolated demo sessions: generate at least 32 random characters.
AUTH_SESSION_SECRET=
# Optional Gemini provider; absent key uses clearly labelled reference responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
